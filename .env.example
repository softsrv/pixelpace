# Read by the app at startup: ./.env by default, or the file CONFIG_FILE names
# (containers mount it at /config/.env). Environment variables override it.

# Application
APP_ENV=development          # "development" or "production"
PORT=8080
APP_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://user:password@localhost:5432/appdb?sslmode=disable
DB_MAX_CONNS=25

# Live race fan-out (make dev starts Valkey locally)
VALKEY_ADDR=localhost:6379

# JWT
# Rotating JWT_SECRET forces every Concept2 connection to reconnect.
JWT_SECRET=<at-least-32-bytes-of-random-secret-here>
JWT_ACCESS_EXPIRY=15m
# Session idle lifetime: each use slides it forward, so a user who has not
# visited for this long must log in again (240h = 10 days).
REFRESH_TOKEN_EXPIRY=240h

# Passwords
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8

# SMTP (required for email verification and password reset)
# Local dev: make dev starts smtp4dev automatically (SMTP on :2525, web UI on :5000)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=MyApp

# Concept2 Logbook integration (optional)
# Register redirect URI: <APP_BASE_URL>/profile/concept2/callback
# Uses log-dev until trusted client approval from Concept2; switch to https://log.concept2.com after approval.
# CONCEPT2_CLIENT_ID=
# CONCEPT2_CLIENT_SECRET=
# CONCEPT2_BASE_URL=https://log-dev.concept2.com
